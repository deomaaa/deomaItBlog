# deomaBlog production environment file.
# Copy to /etc/deomablog/deomablog.env and set mode 600 (root:www-data).
#
#   sudo install -d -o root -g www-data -m 750 /etc/deomablog
#   sudo install -o root -g www-data -m 640 deploy/deomablog.env.example /etc/deomablog/deomablog.env

# ASP.NET Core configuration keys use "__" as the section separator.
ConnectionStrings__Default=Data Source=/var/lib/deomablog/blog.db

# Required to enable POST/PUT/DELETE under /api/posts. Generate with:
#   openssl rand -hex 32
Admin__ApiKey=

Serilog__MinimumLevel__Default=Information
