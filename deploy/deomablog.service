[Unit]
Description=DeomaBlog — ASP.NET Core blog (Kestrel behind nginx)
Documentation=https://github.com/deomaaa/deomaItBlog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/deomablog

# Secrets (Admin__ApiKey, connection string overrides) live here, mode 600 root:www-data.
EnvironmentFile=/etc/deomablog/deomablog.env

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_EnableDiagnostics=0

ExecStart=/usr/local/bin/dotnet /var/www/deomablog/DeomaBlog.Web.dll

User=www-data
Group=www-data

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# Hardening: the service only needs its own database directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/deomablog

StandardOutput=journal
StandardError=journal
SyslogIdentifier=deomablog

[Install]
WantedBy=multi-user.target
